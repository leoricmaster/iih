# 复制为 .env 使用；密钥不入 git（技术架构 §7）

# 数据库连接（本地默认指向 compose 暴露的 postgres；容器内由 compose 注入）
DATABASE_URL=postgresql+psycopg://iih:iih@localhost:5432/iih

# 文件存储目录（原文快照、原始素材）
FILE_STORAGE_DIR=/data/filestore

# LLM：OpenAI 兼容端点，起步 DeepSeek；切 provider 只改这里不动代码
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# 阿里云听悟 ASR（录音转写，IIH-02.01）；四项全填才启用，留空则录音上传关闭
# AK 为账号级 RAM 子用户凭据（建议仅授 OSS + 智能语音交互权限），听悟调用与 OSS 中转共用；
# OSS_BUCKET/REGION 填中转桶及其建桶地域；音频经该桶中转（需与听悟同账号）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
TINGWU_APP_KEY=
OSS_BUCKET=
OSS_REGION=cn-hangzhou
TINGWU_REGION_ID=cn-beijing
